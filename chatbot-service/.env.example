# Copy this file to .env and adjust as needed. Never commit .env itself.

# Local Ollama model used for generation and query rewriting.
MODEL_NAME=llama3.1:8b

# Local, free sentence-transformers embedding model (downloaded once on first run).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the Chroma vector store is persisted.
VECTOR_DB_PATH=./chroma_db

# Port this service listens on.
PORT=8000

# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# How many chunks to retrieve per query.
RETRIEVAL_K=4

# Below this relevance score, a question is treated as out-of-domain and the
# LLM is not called. Tune this after running test_retrieval.py locally.
RELEVANCE_THRESHOLD=0.15

# How many past user+assistant turns to keep per conversation session.
MAX_HISTORY_TURNS=6

# slowapi rate limit format, e.g. "20/minute"
RATE_LIMIT=20/minute
