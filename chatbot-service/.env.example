# AuthNode backend used by read-only verification tools.
AUTHNODE_API_URL=http://localhost:5000/api

# Local Ollama runtime and model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings and vector database.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./chroma_db

# Service and retrieval configuration.
PORT=8000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
RETRIEVAL_K=4
RELEVANCE_THRESHOLD=0.15
MAX_HISTORY_TURNS=6
RATE_LIMIT=20/minute
